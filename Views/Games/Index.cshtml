@model IEnumerable<GameBacklog.Models.Game>

@{
    ViewData["Title"] = "My Games";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Games</h1>
    <div>
        <a asp-action="Create" class="btn btn-primary">+ Add Game</a>
        <a asp-action="Stats" class="btn btn-outline-info">Statistics</a>
    </div>
</div>

<form asp-action="Index" method="get" class="mb-4">
    <div class="row g-2">
        <div class="col-md-5">
            <input type="text" name="searchString" class="form-control"
                   placeholder="Search by title..." value="@ViewData["CurrentSearch"]" />
        </div>
        <div class="col-md-3">
            @{
                var currentStatus = ViewData["CurrentStatus"] as GameBacklog.Models.GameStatus?;
            }
            <select name="statusFilter" class="form-select">
                <option value="">All statuses</option>
                <option value="WantToPlay" selected="@(currentStatus == GameBacklog.Models.GameStatus.WantToPlay)">Want to Play</option>
                <option value="Playing" selected="@(currentStatus == GameBacklog.Models.GameStatus.Playing)">Playing</option>
                <option value="Completed" selected="@(currentStatus == GameBacklog.Models.GameStatus.Completed)">Completed</option>
                <option value="Dropped" selected="@(currentStatus == GameBacklog.Models.GameStatus.Dropped)">Dropped</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-light text-center py-5 border">
        <h4 class="text-muted">No games found</h4>
        <p class="text-muted mb-3">Your library is empty, or no games match your filters.</p>
        <a asp-action="Create" class="btn btn-primary">Add Your First Game</a>
    </div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th></th>
                <th>@Html.DisplayNameFor(model => model.Title)</th>
                <th>@Html.DisplayNameFor(model => model.Platform)</th>
                <th>@Html.DisplayNameFor(model => model.Genre)</th>
                <th>@Html.DisplayNameFor(model => model.Status)</th>
                <th class="text-center">@Html.DisplayNameFor(model => model.Rating)</th>
                <th>@Html.DisplayNameFor(model => model.DateAdded)</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="width:80px;">
                        @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                        {
                            <img src="@item.CoverImageUrl" alt="@item.Title cover" style="width:70px; height:45px; object-fit:cover;" class="rounded" />
                        }
                        else
                        {
                            <div style="width:70px; height:45px;" class="bg-light rounded d-flex align-items-center justify-content-center">
                                <small class="text-muted">No image</small>
                            </div>
                        }
                    </td>
                    <td>
                        <strong>@Html.DisplayFor(modelItem => item.Title)</strong>
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.Platform)</td>
                    <td>
                        @(string.IsNullOrEmpty(item.Genre) ? "—" : item.Genre)
                    </td>
                    <td>
                        @{
                            var badgeClass = item.Status switch
                            {
                                GameBacklog.Models.GameStatus.WantToPlay => "bg-secondary",
                                GameBacklog.Models.GameStatus.Playing => "bg-primary",
                                GameBacklog.Models.GameStatus.Completed => "bg-success",
                                GameBacklog.Models.GameStatus.Dropped => "bg-danger",
                                _ => "bg-light"
                            };
                        }
                        <span class="badge @badgeClass">@Html.DisplayFor(modelItem => item.Status)</span>
                    </td>
                    <td class="text-center">
                        @(item.Rating.HasValue ? $"{item.Rating} / 10" : "—")
                    </td>
                    <td>
                        @item.DateAdded.ToString("dd MMM yyyy")
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}